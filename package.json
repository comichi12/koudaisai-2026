    "db:remote": "wrangler d1 migrations apply koudaisai-live --remote"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.0.0"
  }
}
