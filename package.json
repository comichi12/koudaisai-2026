{
  "name": "grazie-koudaisai-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./styles/input.css -o ./style.css --minify",
    "test": "node --test tests/*.test.js",
    "dev": "wrangler dev",
    "preview": "node scripts/preview.js",
    "deploy": "wrangler deploy",
